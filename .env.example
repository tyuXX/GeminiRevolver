# API password that clients must use as the API key
API_PASSWORD=your_secure_password_here

# Gemini API keys (comma-separated)
GEMINI_API_KEYS=key1,key2,key3

# Server configuration
PORT=3000

# Logging configuration
LOG_DIR=./logs

# Rate limit configuration (duration in milliseconds)
RATE_LIMIT_DURATION_MS=60000

# Cloudflare Tunnel configuration (for Docker deployment)
# Get your tunnel token from: https://dash.cloudflare.com/
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
